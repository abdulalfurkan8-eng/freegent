{
  "name": "freegent",
  "version": "1.0.0",
  "description": "Autonomous AI coding and Windows computer-control agent with DeepSeek and Gemini web providers",
  "type": "module",
  "bin": {
    "freegent": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "lint": "eslint src --max-warnings 0",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "prepack": "npm run build && node -e \"require('fs').accessSync('dist/index.js')\"",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "deepseek",
    "gemini",
    "coding-assistant",
    "playwright",
    "computer-use"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^9.3.1",
    "ora": "^8.1.0",
    "playwright": "^1.46.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "eslint": "^9.35.0",
    "@eslint/js": "^9.35.0",
    "typescript-eslint": "^8.42.0"
  }
}
